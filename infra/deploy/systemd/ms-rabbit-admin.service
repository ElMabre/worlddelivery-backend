[Unit]
Description=World Delivery ms-rabbit-admin
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=worlddelivery
Group=worlddelivery
WorkingDirectory=/var/lib/worlddelivery/ms-rabbit-admin
EnvironmentFile=/etc/worlddelivery/ms-rabbit-admin.env
ExecStart=/usr/bin/java -Xms64m -Xmx256m -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=64m -XX:MaxDirectMemorySize=64m -XX:+ExitOnOutOfMemoryError -jar /opt/worlddelivery/ms-rabbit-admin.jar
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/worlddelivery/ms-rabbit-admin
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
